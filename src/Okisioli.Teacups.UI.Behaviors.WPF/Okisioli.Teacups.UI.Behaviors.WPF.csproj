<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PackageId>Okisioli.Teacups.UI.Behaviors.WPF</PackageId>
    <Version>0.5.0</Version>
    <Description>Reusable WPF and XAML behaviors for .NET desktop applications.</Description>
    <PackageReleaseNotes>Use standard XAML Behavior base classes for ListBoxDoubleClickBehavior and LongPressBehavior.</PackageReleaseNotes>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" />
  </ItemGroup>
</Project>
