<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
      <Version>0.5.0</Version>
      <AssemblyName>Okisioli.Teacups.UI.Core</AssemblyName>
      <RootNamespace>Okisioli.Teacups.UI.Core</RootNamespace>
      <PackageVersion>0.5.0</PackageVersion>
      <PackageReleaseNotes>Added the generic IDialogService abstraction for displaying dialogs on platform-specific UI frameworks.</PackageReleaseNotes>
      <PackageDescription>
        Base library providing abstractions for every other UI-related component in the Okisioli.Teacups family.
