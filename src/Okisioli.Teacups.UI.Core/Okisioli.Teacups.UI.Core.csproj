<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
      <GenerateDocumentationFile>true</GenerateDocumentationFile>
      <NoWarn>$(NoWarn);CS1591</NoWarn>
      <Version>0.11.1</Version>
      <AssemblyName>Okisioli.Teacups.UI.Core</AssemblyName>
      <RootNamespace>Okisioli.Teacups.UI.Core</RootNamespace>
      <PackageReleaseNotes>Fix the UI-freezing regression by always queueing dispatcher actions and exposing ApplicationIdle, Background, Input, and Normal priorities.</PackageReleaseNotes>
      <PackageDescription>
        Base library providing abstractions for every other UI-related component in the Okisioli.Teacups family.
        Contains interfaces to be implemented in a framework-specific way (WPF, Avalonia), abstracting away their specifics.
      </PackageDescription>
    </PropertyGroup>

</Project>
