<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Okisioli.Teacups.UI.Controls.Avalonia;assembly=Okisioli.Teacups.UI.Controls.Avalonia"
        xmlns:demo="clr-namespace:Okisioli.Teacups.UI.Demo.Avalonia"
        xmlns:behaviors="clr-namespace:Okisioli.Teacups.UI.Behaviors.Avalonia;assembly=Okisioli.Teacups.UI.Behaviors.Avalonia"
        xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Xaml.Behaviors.Interactivity"
        x:Class="Okisioli.Teacups.UI.Demo.Avalonia.MainWindow"
        x:DataType="demo:MainWindow"
        Width="760"
        Height="500"
        MinWidth="620"
        MinHeight="420"
        Title="Teacups UI demo">
  <TabControl Margin="20">
    <TabItem Header="Circular ProgressBar">
      <Grid Margin="16" ColumnDefinitions="280,*" ColumnSpacing="44">
    <Border Grid.Column="0"
            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
            CornerRadius="16"
            Padding="28">
      <StackPanel HorizontalAlignment="Center" Spacing="18">
        <ProgressBar x:Name="DemoProgress"
                     Classes="circular"
                     Width="190"
                     Height="190"
                     Minimum="0"
                     Maximum="100"
                     Value="64"
                     Background="#323946"
                     Foreground="#4FD1C5"
                     local:CircularProgress.RingThickness="14" />
        <TextBlock HorizontalAlignment="Center"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Text="{Binding #DemoProgress.Value, StringFormat={}{0:0}% complete}" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="16">
      <TextBlock FontSize="28" FontWeight="SemiBold" Text="Circular ProgressBar" />
      <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                 TextWrapping="Wrap"
                 Text="This is an ordinary ProgressBar using the circular style from the controls package." />

      <TextBlock Margin="0,12,0,0" Text="Progress" />
      <Slider Minimum="0"
              Maximum="100"
              Value="{Binding #DemoProgress.Value, Mode=TwoWay}" />

      <TextBlock Text="Ring thickness" />
      <Slider Minimum="1"
              Maximum="40"
              Value="{Binding #DemoProgress.(local:CircularProgress.RingThickness), Mode=TwoWay}" />

      <CheckBox Content="Reverse (counter-clockwise)"
                IsChecked="{Binding #DemoProgress.(local:CircularProgress.Reverse), Mode=TwoWay}" />

      <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                 TextWrapping="Wrap"
                 Text="Foreground is the filled arc; Background is the remaining ring." />
    </StackPanel>
      </Grid>
    </TabItem>

    <TabItem Header="Behaviors">
      <StackPanel Margin="28" Spacing="16">
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Behavior demos" />
        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   TextWrapping="Wrap"
                   Text="Try each interaction, then check the console for the message produced by the behavior." />

        <TextBlock Margin="0,12,0,0" Text="Long press" />
        <Button HorizontalAlignment="Left" Content="Press and hold me for half a second">
          <i:Interaction.Behaviors>
            <behaviors:LongPressBehavior Command="{Binding LongPressCommand}" Duration="0:0:0.5" />
          </i:Interaction.Behaviors>
        </Button>

        <TextBlock Margin="0,12,0,0" Text="List item double-click" />
        <ListBox Width="320" Height="120" ItemsSource="{Binding DemoItems}">
          <i:Interaction.Behaviors>
            <behaviors:ListBoxDoubleClickBehavior Command="{Binding ListBoxDoubleClickCommand}" />
          </i:Interaction.Behaviors>
        </ListBox>
      </StackPanel>
    </TabItem>
  </TabControl>
</Window>
