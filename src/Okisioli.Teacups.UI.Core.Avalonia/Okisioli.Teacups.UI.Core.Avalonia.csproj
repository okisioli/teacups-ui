<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Version>0.11.1</Version>
        <PackageReleaseNotes>Fix the UI-freezing regression by always queueing dispatcher actions and exposing ApplicationIdle, Background, Input, and Normal priorities.</PackageReleaseNotes>
        <AssemblyName>Okisioli.Teacups.UI.Core.Avalonia</AssemblyName>
        <RootNamespace>Okisioli.Teacups.UI.Core.Avalonia</RootNamespace>
        <PackageDescription>Avalonia implementation of the Okisioli.Teacups.UI abstractions.</PackageDescription>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Avalonia" />
      <ProjectReference Include="..\Okisioli.Teacups.UI.Core\Okisioli.Teacups.UI.Core.csproj" />
    </ItemGroup>

</Project>
