<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Okisioli.Teacups.UI.Controls.Avalonia"
             x:Class="Okisioli.Teacups.UI.Controls.Avalonia.BottomSheet"
             x:Name="Root">
  <UserControl.Resources>
    <PageSlide x:Key="DefaultSheetSlide" Orientation="Vertical" Duration="0:00:00.25" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="local|BottomSheet">
      <Setter Property="OpenTransition" Value="{StaticResource DefaultSheetSlide}" />
      <Setter Property="CloseTransition" Value="{StaticResource DefaultSheetSlide}" />
      <Setter Property="BackdropBrush" Value="#80000000" />
    </Style>
  </UserControl.Styles>
  <Grid>
    <ContentPresenter x:Name="MainContentPresenter" />
    <Border x:Name="Backdrop"
            Background="{Binding BackdropBrush, ElementName=Root}"
            IsHitTestVisible="False"
            Opacity="0">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:00:00.15" />
        </Transitions>
      </Border.Transitions>
    </Border>
    <Grid x:Name="SheetLayer"
          ClipToBounds="True"
          IsHitTestVisible="{Binding IsExpanded, ElementName=Root}"
          IsVisible="False">
      <Grid VerticalAlignment="Bottom">
        <ContentPresenter x:Name="SheetContentPresenter"
                          Background="Transparent"
                          Content="{Binding SheetContent, ElementName=Root}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
