<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Okisioli.Teacups.UI.Controls.Avalonia.RootView"
             x:Name="Root">
  <Grid ClipToBounds="True">
    <ContentPresenter Content="{Binding MainContent, ElementName=Root}" />
    <ContentPresenter x:Name="SnackbarLayer"
                      Content="{Binding SnackbarContent, ElementName=Root}"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24" />
    <ContentPresenter Content="{Binding ToastContent, ElementName=Root}"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24"
                      IsHitTestVisible="False" />
  </Grid>
</UserControl>
