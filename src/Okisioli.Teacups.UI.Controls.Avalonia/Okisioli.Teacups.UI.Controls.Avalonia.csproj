<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Okisioli.Teacups.UI.Controls.Avalonia</PackageId>
    <Version>0.13.0</Version>
    <Description>Reusable Avalonia control styles for Okisioli.Teacups applications.</Description>
    <PackageReleaseNotes>Bottom sheets now slide in by default and fade in a backdrop over their main content. Set OpenTransition or BackdropBrush to customize or disable either effect.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Themes\CircularProgressBar.axaml" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
