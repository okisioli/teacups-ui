<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Okisioli.Teacups.UI.Controls.Avalonia</PackageId>
    <Version>0.12.0</Version>
    <Description>Reusable Avalonia control styles for Okisioli.Teacups applications.</Description>
    <PackageReleaseNotes>Bottom sheets now close via Escape, system Back, or an outside click or tap by default. Set IsModal to keep the sheet open during those interactions.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Themes\CircularProgressBar.axaml" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
