<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <TargetFramework>net10.0-windows</TargetFramework>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
        <Version>0.11.1</Version>
        <PackageReleaseNotes>Fix the UI-freezing regression by always queueing dispatcher actions and exposing ApplicationIdle, Background, Input, and Normal priorities.</PackageReleaseNotes>
        <AssemblyName>Okisioli.Teacups.UI.Core.WPF</AssemblyName>
        <RootNamespace>Okisioli.Teacups.UI.Core.WPF</RootNamespace>
        <PackageDescription>WPF implementation of the Okisioli.Teacups.UI abstractions.</PackageDescription>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\\Okisioli.Teacups.UI.Core\\Okisioli.Teacups.UI.Core.csproj" />
    </ItemGroup>

</Project>
