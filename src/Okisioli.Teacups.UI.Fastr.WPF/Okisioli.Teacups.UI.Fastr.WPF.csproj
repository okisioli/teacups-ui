<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <AssemblyName>Fastr.WPF</AssemblyName>
    <PackageId>Okisioli.Teacups.UI.Fastr.WPF</PackageId>
    <Version>0.7.0</Version>
    <Description>WPF behaviors and collections for displaying and replacing large item sets.</Description>
    <RepositoryUrl>https://github.com/okisioli/teacups-ui</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Move Fastr WPF into Teacups UI and build against the shared Core project.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <ProjectReference Include="../Okisioli.Teacups.UI.Core/Okisioli.Teacups.UI.Core.csproj" />
  </ItemGroup>
</Project>
