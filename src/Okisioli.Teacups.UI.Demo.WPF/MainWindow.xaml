<Window x:Class="Okisioli.Teacups.UI.Demo.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teacups UI WPF demo"
        Width="760"
        Height="500"
        MinWidth="620"
        MinHeight="420">
  <TabControl Margin="20">
    <TabItem Header="Dialogs">
      <StackPanel Margin="28" VerticalAlignment="Center">
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Dialog service" />
        <TextBlock Margin="0,16,0,0"
                   TextWrapping="Wrap"
                   Text="Open a dialog hosted by the WPF dialog service." />
        <Button Margin="0,16,0,0"
                HorizontalAlignment="Left"
                Padding="12,6"
                Click="OnShowDialogClick"
                Content="Show dialog" />
        <TextBlock x:Name="DialogResultText" Margin="0,16,0,0" Text="No dialog result yet." />
      </StackPanel>
    </TabItem>
  </TabControl>
</Window>
