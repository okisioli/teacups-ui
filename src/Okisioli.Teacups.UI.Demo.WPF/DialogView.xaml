<UserControl x:Class="Okisioli.Teacups.UI.Demo.WPF.DialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="28" MinWidth="320" MinHeight="180">
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel VerticalAlignment="Center">
      <TextBlock HorizontalAlignment="Center" FontSize="28" FontWeight="SemiBold" Text="Dialog" />
      <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Text="This XAML view is hosted by DialogService." />
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Margin="0,0,12,0" Padding="12,6" Click="OnCancelClick" Content="Cancel" />
      <Button Padding="12,6" Click="OnConfirmClick" Content="Confirm" />
    </StackPanel>
  </Grid>
</UserControl>
