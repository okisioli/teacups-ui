<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Okisioli.Teacups.UI.Controls.Avalonia;assembly=Okisioli.Teacups.UI.Controls.Avalonia"
        xmlns:demo="clr-namespace:Okisioli.Teacups.UI.Demo.Avalonia"
        xmlns:behaviors="clr-namespace:Okisioli.Teacups.UI.Behaviors.Avalonia;assembly=Okisioli.Teacups.UI.Behaviors.Avalonia"
        xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Xaml.Behaviors.Interactivity"
        x:Class="Okisioli.Teacups.UI.Demo.Avalonia.MainWindow"
        x:DataType="demo:MainWindow">
  <TabControl Margin="20,0,20,20">
    <TabItem Header="Controls">
      <ListBox Margin="0,4,0,0"
               AutomationProperties.Name="Control showcases"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="100" />
          </Style>
          <Style Selector="TextBlock.showcase-heading">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Style>
        </ListBox.Styles>

        <ListBoxItem AutomationProperties.Name="Circular Progress Bar">
          <Grid ColumnDefinitions="2*,3*" ColumnSpacing="16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="8">
              <ProgressBar x:Name="DemoProgress"
                           Classes="circular"
                           Width="80"
                           Height="80"
                           Minimum="0"
                           Maximum="100"
                           Value="64"
                           Background="#323946"
                           Foreground="#4FD1C5"
                           local:CircularProgress.RingThickness="14" />
              <TextBlock VerticalAlignment="Center"
                         Text="{Binding #DemoProgress.Value, StringFormat={}{0:0}%}" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Classes="showcase-heading" Text="Circular Progress Bar" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel>
                  <TextBlock Text="Progress" />
                  <Slider AutomationProperties.Name="Progress"
                          Minimum="0"
                          Maximum="100"
                          Value="{Binding #DemoProgress.Value, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Ring thickness" />
                  <Slider AutomationProperties.Name="Ring thickness"
                          Minimum="1"
                          Maximum="40"
                          Value="{Binding #DemoProgress.(local:CircularProgress.RingThickness), Mode=TwoWay}" />
                </StackPanel>
              </Grid>
              <CheckBox Content="Reverse (counter-clockwise)"
                        MinHeight="24"
                        IsChecked="{Binding #DemoProgress.(local:CircularProgress.Reverse), Mode=TwoWay}" />
            </StackPanel>
          </Grid>
        </ListBoxItem>

        <ListBoxItem AutomationProperties.Name="Gamepad Button">
          <Grid ColumnDefinitions="2*,3*" ColumnSpacing="16">
            <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center"
                     MaxHeight="88" StretchDirection="DownOnly">
              <local:GamepadButton />
            </Viewbox>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
              <TextBlock Classes="showcase-heading" Text="Gamepad Button" />
              <TextBlock TextWrapping="Wrap" Text="Press for the center choice, or drag left or right and release." />
            </StackPanel>
          </Grid>
        </ListBoxItem>
      </ListBox>
    </TabItem>

    <TabItem Header="Behaviors">
      <ScrollViewer>
        <StackPanel Margin="28" Spacing="24">
          <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold" Text="Long press" />
            <Button HorizontalAlignment="Left" Content="Press and hold me for half a second">
              <i:Interaction.Behaviors>
                <behaviors:LongPressBehavior Command="{Binding LongPressCommand}" Duration="0:0:0.5" />
              </i:Interaction.Behaviors>
            </Button>
            <TextBlock x:Name="LongPressResult" />
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold" Text="List item double-click" />
            <ListBox HorizontalAlignment="Left" Width="320" Height="120" ItemsSource="{Binding DemoItems}">
              <i:Interaction.Behaviors>
                <behaviors:ListBoxDoubleClickBehavior Command="{Binding ListBoxDoubleClickCommand}" />
              </i:Interaction.Behaviors>
            </ListBox>
            <TextBlock x:Name="ListBoxDoubleClickResult" />
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold" Text="Text box submit" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <TextBox AutomationProperties.Name="Text to submit" PlaceholderText="Type text and press Enter">
                <i:Interaction.Behaviors>
                  <behaviors:TextBoxSubmitBehavior Command="{Binding TextBoxSubmitCommand}"
                                                   ClearOnSubmit="{Binding #ClearSubmittedText.IsChecked}" />
                </i:Interaction.Behaviors>
              </TextBox>
              <CheckBox x:Name="ClearSubmittedText" Grid.Column="1" IsChecked="False" Content="Clear on submit" />
            </Grid>
            <TextBlock x:Name="TextBoxSubmitResult" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold" Text="Tagging text box" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <TextBox AutomationProperties.Name="Tag to submit" PlaceholderText="Type a tag and press comma or Enter">
                <i:Interaction.Behaviors>
                  <behaviors:TaggingTextBoxBehavior Command="{Binding TagSubmitCommand}"
                                                    ClearOnSubmit="{Binding #ClearSubmittedTag.IsChecked}" />
                </i:Interaction.Behaviors>
              </TextBox>
              <CheckBox x:Name="ClearSubmittedTag" Grid.Column="1" IsChecked="True" Content="Clear on submit" />
            </Grid>
            <TextBlock x:Name="TagSubmitResult" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Drawer Sheet">
      <local:DrawerSheet x:Name="DemoDrawerSheet">
        <local:DrawerSheet.SheetContent>
          <StackPanel Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" Spacing="8">
            <TextBlock Margin="16,16,16,0" FontWeight="SemiBold" Text="Sheet content" />
            <TextBox Margin="16,0" Text="First text box" />
            <TextBox Margin="16,0" Text="Second text box" />
            <TextBox Margin="16,0" Text="Third text box" />
            <Button Margin="16,0,16,16" Content="Close sheet" Click="OnCloseDrawerSheetClick" />
            <Border Width="1200" Height="900"
                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    IsVisible="{Binding #DrawerOverflow.IsChecked}">
              <TextBlock Margin="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Text="End of sheet content" />
            </Border>
          </StackPanel>
        </local:DrawerSheet.SheetContent>

        <ScrollViewer Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
          <StackPanel Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <TextBlock HorizontalAlignment="Center" FontSize="28" FontWeight="SemiBold" Text="Drawer Sheet" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12" RowSpacing="8"
                  IsEnabled="{Binding !#DemoDrawerSheet.IsExpanded}">
              <ComboBox x:Name="DrawerPlacement" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Slide from"
                        ItemsSource="{Binding DrawerPlacements}" SelectedIndex="0" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Slide from" />
              <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock Text="Horizontal alignment" />
                <ComboBox x:Name="DrawerHorizontalAlignment" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Horizontal alignment"
                          ItemsSource="{Binding DrawerHorizontalAlignments}" SelectedIndex="0" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                <TextBlock Text="Vertical alignment" />
                <ComboBox x:Name="DrawerVerticalAlignment" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Vertical alignment"
                          ItemsSource="{Binding DrawerVerticalAlignments}" SelectedIndex="0" />
              </StackPanel>
              <StackPanel Grid.Row="2" Spacing="4">
                <TextBlock Text="Minimum width" />
                <NumericUpDown x:Name="DrawerMinWidth" AutomationProperties.Name="Minimum width"
                               Minimum="0" Increment="20" Value="0" />
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                <TextBlock Text="Minimum height" />
                <NumericUpDown x:Name="DrawerMinHeight" AutomationProperties.Name="Minimum height"
                               Minimum="0" Increment="20" Value="0" />
              </StackPanel>
            </Grid>
            <StackPanel IsEnabled="{Binding !#DemoDrawerSheet.IsExpanded}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <CheckBox Content="Modal" IsChecked="{Binding #DemoDrawerSheet.IsModal, Mode=TwoWay}" />
                <CheckBox x:Name="DrawerOverflow" Content="Oversized content" IsChecked="False" />
              </StackPanel>
              <CheckBox Content="Reset scroll position on open"
                        IsChecked="{Binding #DemoDrawerSheet.ResetScrollPosition, Mode=TwoWay}" />
            </StackPanel>
            <Button HorizontalAlignment="Center"
                    Content="Show sheet"
                    Click="OnShowDrawerSheetClick" />
          </StackPanel>
        </ScrollViewer>
      </local:DrawerSheet>
    </TabItem>

    <TabItem Header="Dialogs">
      <StackPanel Margin="28" Spacing="16" VerticalAlignment="Center">
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Dialog service" />
        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   TextWrapping="Wrap"
                   Text="Open a full-screen dialog implemented by the Avalonia dialog service." />
        <Button HorizontalAlignment="Left" Content="Show dialog"
                IsEnabled="{Binding CanShowDialog}" Click="OnShowDialogClick" />
        <TextBlock Text="{Binding DialogResult}" />
      </StackPanel>
    </TabItem>
  </TabControl>
</UserControl>
