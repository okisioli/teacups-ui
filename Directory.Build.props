<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <ArtifactsPath>$(MSBuildThisFileDirectory)build</ArtifactsPath>
    <PackageOutputPath>$(MSBuildThisFileDirectory)publish</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>$(AssemblyName)</PackageId>

    <Authors>Okisioli</Authors>
    <Company>Okisioli</Company>

    <RepositoryUrl>https://github.com/oli-g-sk/teacups-ui</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
</Project>
